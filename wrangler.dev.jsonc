{
  "name": "bloodwork-local",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXTJS_ENV": "development",
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "3ce48886bf744930a9e9114f7c707019",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloodwork-db",
      "database_id": "59c89aab-650f-4814-9182-dc6691e74237",
      "migrations_dir": "db/migrations",
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "bloodwork-db",
      "database_id": "59c89aab-650f-4814-9182-dc6691e74237",
    },
  ],
}
