{
  "name": "bloodwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run format && bun run lint:fix && bun run typecheck & TC=$!; bun run test; TEST=$?; wait $TC; TC=$?; exit $((TEST || TC))",
    "build:worker": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "check:full": "bun run check && bun run build:worker && bun run verify:deployment",
    "db:migrate": "wrangler d1 execute bloodwork-db --local --config wrangler.dev.jsonc --file=db/schema.sql",
    "db:seed": "bun run db/migrate.ts",
    "plan:production": "bun run build:worker && bun run verify:deployment && bun alchemy plan --stage prod",
    "deploy:production": "bun run check:full && bun alchemy deploy --stage prod",
    "verify:deployment": "bun run scripts/verify-effect-alchemy.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@google/generative-ai": "^0.24.1",
    "@opennextjs/cloudflare": "^1.18.0",
    "alchemy": "2.0.0-beta.65",
    "effect": "4.0.0-beta.102",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.78.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
